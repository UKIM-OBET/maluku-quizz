{
  "name": "malukuquizz/maluku-culture-gamification",
  "description": "Website gamifikasi pengenalan budaya Maluku Tengah dengan fitur kuis dan leaderboard.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "classmap": [
      "database/seeders"
    ]
  },
  "scripts": {
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd": ["@php artisan key:generate"],
    "post-install-cmd": ["@php artisan key:generate"]
  },
  "minimum-stability": "stable",
  "license": "MIT"
}
